[Unit]
Description=Quant: JoinQuant daily web sign-in (claim credits)
Wants=network-online.target
After=network-online.target
StartLimitIntervalSec=3600
StartLimitBurst=3

[Service]
Type=oneshot
User=@RUN_AS_USER@
WorkingDirectory=@REPO_ROOT@
EnvironmentFile=@REPO_ROOT@/.env
EnvironmentFile=@REPO_ROOT@/deploy/home_data_node/.env
Environment=HOME=@RUN_AS_HOME@
Environment=PATH=@RUN_AS_HOME@/.local/bin:/usr/local/sbin:/usr/local/bin:/usr/sbin:/usr/bin:/sbin:/bin
Environment=JQ_DEBUG_DIR=@REPO_ROOT@/output

ExecStart=@REPO_ROOT@/deploy/home_data_node/bin/run-jq-signin.sh

StandardOutput=journal
StandardError=journal
SyslogIdentifier=quant-jq-signin

TimeoutStartSec=600
Restart=on-failure
RestartSec=300

[Install]
WantedBy=multi-user.target
