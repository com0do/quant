# =============================================================================
# deploy/home_data_node/.env
#
# Home data node configuration. Put the JoinQuant account in the repo-root .env (JQ_USERNAME / JQ_PASSWORD).
# The daily job is executed by a single systemd unit, quant-daily.service:
#   check-in -> JQ sync -> news archive -> 3-year LRU purge -> (optional) R2 cold backup
# =============================================================================

# ---- Daily job schedule (systemd OnCalendar, UTC) ---------------------------------
# Default 08:10 CST = 00:10 UTC
DAILY_ONCALENDAR="*-*-* 00:10:00 UTC"

# ---- JQ sync ----------------------------------------------------------------
# Incremental window in days (the script tracks progress in the sync_progress table, so a wide window only fills gaps)
JQ_SYNC_LOOKBACK_DAYS=60

JQ_SYNC_CSI1000_DB="data/runtime/market_csi1000_latest.db"
JQ_SYNC_CSI2000_DB="data/runtime/market_csi2000_latest.db"
JQ_SYNC_CSI300_500_DB="data/runtime/market_csi300_500_latest.db"

# ---- Data retention (LRU) ---------------------------------------------------------
# Rows older than N years in prices_daily / factors / fundamentals etc. are removed with DELETE + VACUUM
DATA_RETENTION_YEARS=3

# ---- JoinQuant website check-in ------------------------------------------------------------
# The Gitee Go pipeline .workflow/jq-signin.yml does the same every day; set false to keep only one of them.
JQ_SIGNIN_ENABLE=true

# ---- News / theme archive (scripts/news_archive.py -> data/news/) -------------------------------
NEWS_ARCHIVE_ENABLE=true
NEWS_ARCHIVE_SOURCES=ths_limit_up,em_zt_pool,em_fast,sina_7x24,irm_qa,concept_tags
# Covers the gap between two daily runs plus a margin
NEWS_ARCHIVE_LOOKBACK_HOURS=30

# ---- Cloudflare R2 cold backup (optional; for office/CI data pulls, the home node runs fine without R2) ---
R2_ENABLE=false
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_ENDPOINT=
R2_BUCKET=quant-data
R2_HOSTNAME_PREFIX=home
R2_KEEP_LAST=14

# ---- Tailscale (optional) --------------------------------------------------------
TAILSCALE_ENABLE=false
TAILSCALE_AUTHKEY=

# ---- Suspend after sync to save power (not recommended; always-on is more stable) ---------------------------------------
SUSPEND_AFTER_SYNC=false
