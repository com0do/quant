# =============================================================================
# Template .env for the main quant project
# Copy to .env and fill in. .env is in .gitignore and will not be committed.
# The gateway server has its own deploy/gateway_server/.env.example for the Windows side.
# =============================================================================

# ------ JoinQuant (JQData) ------
# Used by main.py --mode jq-bulk-sync and the related workflows.
# The variable names match what quant/stock_data/jq_client.py and scripts/jq_bulk_sync_smallcap.py read.
# The same names are used everywhere: GitHub Secrets, Gitee Go general variables and this file.
JQ_USERNAME=
JQ_PASSWORD=

# ------ HTTP proxy (optional; for reaching JoinQuant/DeepSeek from a corporate network) ------
# HTTP_PROXY=http://10.144.1.10:8080
# HTTPS_PROXY=http://10.144.1.10:8080
# http_proxy=http://10.144.1.10:8080
# https_proxy=http://10.144.1.10:8080
# no_proxy=localhost,127.0.0.1/8,::1,192.168.0.0/16,10.67.0.0/16

# ------ QMT gateway (client on Linux calling Windows) ------
QMT_GATEWAY_TOKEN=
QMT_ACCOUNT_ID=

# ------ DeepSeek (shared by the LLM layer and the Hermes agent backend) ----------------------------
# One-shot structured extraction: main.py --mode nlp-analyze
# Hermes agent scenario: main.py --mode hermes-chat (forwarded through ~/.hermes)
#
# Official API: https://platform.deepseek.com
# Defaults to https://api.deepseek.com; you can also point it at SiliconFlow or a self-hosted OpenAI-compatible endpoint.
DEEPSEEK_API_KEY=
DEEPSEEK_MODEL=deepseek-chat
DEEPSEEK_BASE_URL=https://api.deepseek.com
DEEPSEEK_TIMEOUT_SEC=60
DEEPSEEK_TEMPERATURE=0.1
DEEPSEEK_MAX_TOKENS=1024

# ------ Hermes agent (used by --mode hermes-chat) ------------------------------
# hermes-agent is installed in ~/.hermes/ (with its own Py 3.11 venv); this repo uses it via the `hermes` CLI + a profile.
# Install: bash hermes_plugin/setup.sh
#
# **Note**: hermes-related environment variables belong in the hermes profile's .env (e.g. ~/.hermes/profiles/quant/.env),
# not here: this .env only affects the Python code in the main quant venv. When hermes loads the plugin it reads the profile's .env.
#
# Only needed when you want to override it manually in the main venv:
# HERMES_ROOT=~/.hermes                        # defaults to ~/.hermes; set only if hermes is installed elsewhere

# ------ JoinQuant -> Redis signal bridge (optional) ------
JQ_SIGNAL_HMAC_SECRET=
