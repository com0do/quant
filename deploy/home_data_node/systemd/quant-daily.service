[Unit]
Description=Quant home node: daily sign-in + JQ sync + retention purge (+ optional R2)
Wants=network-online.target
After=network-online.target
StartLimitIntervalSec=7200
StartLimitBurst=2

[Service]
Type=oneshot
User=@RUN_AS_USER@
WorkingDirectory=@REPO_ROOT@
EnvironmentFile=@REPO_ROOT@/.env
EnvironmentFile=@REPO_ROOT@/deploy/home_data_node/.env
Environment=HOME=@RUN_AS_HOME@
Environment=PATH=@RUN_AS_HOME@/.local/bin:/usr/local/sbin:/usr/local/bin:/usr/sbin:/usr/bin:/sbin:/bin
Environment=JQ_DEBUG_DIR=@REPO_ROOT@/output

ExecStart=@REPO_ROOT@/deploy/home_data_node/bin/run-daily.sh

StandardOutput=journal
StandardError=journal
SyslogIdentifier=quant-daily

TimeoutStartSec=10800
Restart=on-failure
RestartSec=600

[Install]
WantedBy=multi-user.target
