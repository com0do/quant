# =============================================================================
# 主 quant 项目 .env 模板
# 复制为 .env 后填写。.env 已在 .gitignore，不会被提交。
# 网关服务端有自己的 deploy/gateway_server/.env.example，用于 Windows 侧。
# =============================================================================

# ------ 聚宽（JQData）------
# 用于 main.py --mode jq-bulk-sync 与相关 workflow。
# 变量名对应 quant/stock_data/jq_client.py 与 scripts/jq_bulk_sync_smallcap.py 中的读取。
# CI 里映射：CC_JQ_NAME=${{ secrets.JQ_USERNAME }} / CC_JQ_PW=${{ secrets.JQ_PASSWORD }}
CC_JQ_NAME=
CC_JQ_PW=

# ------ HTTP 代理（可选，公司网络下访问外网聚宽/DeepSeek 时用）------
# HTTP_PROXY=http://10.144.1.10:8080
# HTTPS_PROXY=http://10.144.1.10:8080
# http_proxy=http://10.144.1.10:8080
# https_proxy=http://10.144.1.10:8080
# no_proxy=localhost,127.0.0.1/8,::1,192.168.0.0/16,10.67.0.0/16

# ------ QMT 网关（客户端从 Linux 调 Windows）------
QMT_GATEWAY_TOKEN=
QMT_ACCOUNT_ID=

# ------ DeepSeek（LLM 层 + Hermes agent 后端共用）----------------------------
# 一次性结构化提取：main.py --mode nlp-analyze
# Hermes agent 场景：main.py --mode hermes-chat（通过 ~/.hermes 转发过去用）
#
# 官方 API：https://platform.deepseek.com
# 默认走 https://api.deepseek.com；也可指到硅基流动 / 自建 OpenAI 兼容端点。
DEEPSEEK_API_KEY=
DEEPSEEK_MODEL=deepseek-chat
DEEPSEEK_BASE_URL=https://api.deepseek.com
DEEPSEEK_TIMEOUT_SEC=60
DEEPSEEK_TEMPERATURE=0.1
DEEPSEEK_MAX_TOKENS=1024

# ------ Hermes agent（--mode hermes-chat 使用）------------------------------
# hermes-agent 装在 ~/.hermes/（含独立 Py 3.11 venv），本仓库通过 `hermes` CLI + profile 使用。
# 装法：bash hermes_plugin/setup.sh
#
# **注意**：跟 hermes 相关的环境变量应该写到 hermes profile 的 .env（例如 ~/.hermes/profiles/quant/.env），
# 不是这里——本 .env 只影响主 quant venv 里的 Python 代码。hermes 加载 plugin 时读的是 profile 的 .env。
#
# 仅在你要在主 venv 里手动覆盖时才用得上：
# HERMES_ROOT=~/.hermes                        # 默认 ~/.hermes；换位置装 hermes 才要设

# ------ 聚宽 → Redis 信号桥（可选）------
JQ_SIGNAL_HMAC_SECRET=
