# Required
XTG_ACCOUNT_ID=YOUR_ACCOUNT_ID
XTG_MINI_QMT_PATH=C:/path/to/miniqmt/userdata
XTG_TOKEN=YOUR_GATEWAY_TOKEN

# Optional network/runtime
XTG_HOST=0.0.0.0
XTG_PORT=18080
XTG_STATE_DB_PATH=data/xtquant_gateway.db

# Optional: auto-launch miniQMT executable before gateway
XTG_MINI_QMT_EXE_PATH=C:/path/to/miniQMT.exe

# Optional risk/stability knobs
XTG_STALE_QUOTE_GUARD_ENABLE=true
XTG_STALE_QUOTE_MAX_AGE_SEC=8
XTG_LOT_SIZE=100
XTG_RESERVE_CASH_PCT=0.02
XTG_MAX_SINGLE_ORDER_NOTIONAL=300000
XTG_MAX_DAILY_ORDER_COUNT=300
XTG_MAX_DAILY_NOTIONAL=20000000
