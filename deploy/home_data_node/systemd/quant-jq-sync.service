[Unit]
Description=Quant: daily JoinQuant bulk sync
Wants=network-online.target
After=network-online.target
StartLimitIntervalSec=3600
StartLimitBurst=3

[Service]
Type=oneshot
User=@RUN_AS_USER@
WorkingDirectory=@REPO_ROOT@
EnvironmentFile=@REPO_ROOT@/.env
EnvironmentFile=@REPO_ROOT@/deploy/home_data_node/.env
Environment=HOME=@RUN_AS_HOME@
Environment=PATH=@RUN_AS_HOME@/.local/bin:/usr/local/sbin:/usr/local/bin:/usr/sbin:/usr/bin:/sbin:/bin

ExecStart=@REPO_ROOT@/deploy/home_data_node/bin/run-jq-sync.sh

# All output goes to the journal
StandardOutput=journal
StandardError=journal
SyslogIdentifier=quant-jq-sync

# A single run may take at most 2 hours
TimeoutStartSec=7200

# Restart on failure up to 3 times, 5 minutes apart
Restart=on-failure
RestartSec=300

[Install]
WantedBy=multi-user.target
